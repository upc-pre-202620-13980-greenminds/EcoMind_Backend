FROM maven:3.9-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320 AS build
WORKDIR /build

COPY .mvn .mvn
COPY mvnw pom.xml ./
COPY src src
RUN bash ./mvnw --batch-mode --no-transfer-progress package -Dmaven.test.skip=true

FROM eclipse-temurin:24-jre@sha256:8cb2387a28af84cf0db0948d9c67d4480192f4e567027a3963f145d218e8b4f2
WORKDIR /app

ARG GIT_COMMIT=unreleased
LABEL org.opencontainers.image.revision=$GIT_COMMIT

RUN useradd --system --uid 10001 --no-create-home ecomind
COPY --from=build --chown=10001:10001 /build/target/ecomind-backend-*.jar app.jar

ENV SPRING_PROFILES_ACTIVE=prod,azure \
    PORT=8080 \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=65.0 -XX:+ExitOnOutOfMemoryError"

USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
